{
  "expo": {
    "name": "Rideshare",
    "slug": "rideshare",
    "scheme": "rideshare",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#00aff5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rideshare.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show pickup points and live driver position.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Drivers share their position with passengers during a trip.",
        "UIBackgroundModes": [
          "location",
          "location",
          "location",
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.rideshare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#00aff5"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Rideshare to use your location for live trip tracking.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:8000",
      "websocketUrl": "http://10.0.2.2:9000",
      "eas": {
        "projectId": "51ee141a-eef9-479f-847d-0c2d0736ab1c"
      }
    },
    "owner": "ganureddy",
    "updates": {
      "url": "https://u.expo.dev/51ee141a-eef9-479f-847d-0c2d0736ab1c"
    }
  }
}
